[Unit]
Description=docStamp Document Processing Toolbox
After=network.target

[Service]
Type=forking
User=docstamp
Group=docstamp
WorkingDirectory=/opt/docstamp/backend
Environment="PATH=/opt/docstamp/.venv/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/opt/docstamp/.venv/bin/gunicorn -c gunicorn.conf.py app:app
ExecStop=/bin/kill -TERM $MAINPID
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
StandardOutput=append:/var/log/docstamp/app.log
StandardError=append:/var/log/docstamp/error.log

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/log/docstamp /opt/docstamp/backend/output
ReadOnlyPaths=/opt/docstamp

[Install]
WantedBy=multi-user.target
