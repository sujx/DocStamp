{
  "name": "docstamp-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "鹊随金印 文档处理工具箱 - Nuxt + Nuxt UI Frontend",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt generate",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "lint": "eslint . --ext .vue,.ts,.js",
    "lint:fix": "eslint . --ext .vue,.ts,.js --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@nuxt/icon": "^1.10",
    "@nuxt/ui": "^2.21",
    "@nuxtjs/i18n": "^9.5",
    "@vuelidate/core": "^2.0.3",
    "@vuelidate/validators": "^2.0.4",
    "axios": "^1.7",
    "dompurify": "^3.4.7",
    "echarts": "^6.1.0",
    "highlight.js": "^11.11.1",
    "katex": "^0.17.0",
    "marked": "^18.0.4",
    "mermaid": "^11.15.0",
    "nuxt": "3.15.4",
    "vue-echarts": "^8.0.1"
  },
  "devDependencies": {
    "@vue/test-utils": "^2.4.11",
    "happy-dom": "^20.10.2",
    "vitest": "^4.1.8"
  }
}
