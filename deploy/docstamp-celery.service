[Unit]
Description=docStamp Celery Worker (lite — all queues)
Documentation=https://github.com/grepsu/docStamp
After=network.target redis.service valkey.service
Wants=redis.service valkey.service

[Service]
Type=simple
User=docstamp
Group=docstamp
WorkingDirectory=/opt/docstamp/backend
EnvironmentFile=-/etc/docstamp/env.conf
Environment=PYTHONPATH=/opt/docstamp/backend
ExecStart=/opt/docstamp/.venv/bin/celery -A celery_app worker \
    -Q convert_queue,pdf_queue,office_queue \
    --concurrency=2 --loglevel=info
Restart=always
RestartSec=5
MemoryMax=512M

# ── Security hardening ───────────────────────────────────────────────
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/opt/docstamp/output /var/log/docstamp
ReadOnlyPaths=/opt/docstamp/backend
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
PrivateDevices=yes
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
