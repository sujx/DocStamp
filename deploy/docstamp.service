[Unit]
Description=docStamp Document Processing API
Documentation=https://github.com/grepsu/docStamp
After=network.target redis.service
Wants=redis.service

[Service]
Type=notify
User=docstamp
Group=docstamp
WorkingDirectory=/opt/docstamp/backend
EnvironmentFile=-/etc/docstamp/env.conf
ExecStart=/opt/docstamp/.venv/bin/gunicorn -c gunicorn.conf.py -b 0.0.0.0:5000 --workers 2 wsgi:app
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5

# ── Security hardening ───────────────────────────────────────────────
# Prevent privilege escalation
NoNewPrivileges=yes

# Private /tmp — isolates temporary files from the host
PrivateTmp=yes

# Filesystem namespace protection
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/docstamp/output /var/log/docstamp
ReadOnlyPaths=/opt/docstamp/backend

# Network (no outbound connections beyond local Redis)
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# System call filter
SystemCallFilter=@system-service @network-io

# Deny device access
PrivateDevices=yes

# Deny new capabilities
CapabilityBoundingSet=

# Memory limits (512M for lite, raise to 2G for full mode)
MemoryMax=512M

# Process limits
LimitNOFILE=4096
LimitNPROC=128

[Install]
WantedBy=multi-user.target
