# 鹊随金印 — Docker Compose 环境变量模板
# 复制为 .env 后填入真实值：cp .env.example .env
# .env 已在 .gitignore 中，不会被提交到代码库

# AI API 配置 — 支持 OpenAI / DeepSeek / Ollama / 其他兼容厂商
# 默认使用 DeepSeek，换成其他厂商只需改 URL 和 Model
AI_API_URL=https://api.deepseek.com/chat/completions
AI_MODEL=deepseek-v4-flash
DOCSTAMP_DEEPSEEK_API_KEY=

# AES-256 密钥 — 用于加密敏感文档属性
# 生成方式：python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DOCSTAMP_ENCRYPTION_KEY=

# CORS 允许的域名（生产环境改为实际域名）
# 阿里云 ACR 推送密码（./publish.sh 使用）
ACR_PASSWORD=
DOCSTAMP_CORS_ORIGINS=http://localhost:8080
