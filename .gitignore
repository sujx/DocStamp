# Node
node_modules/
# No trailing slash: the committed artefact is a symlink, which the
# directory-only form of the pattern would not match.
frontend/dist
npm-debug.log*

# IDE
.vscode/
.idea/

# Project
.pids/
backend/output/*
!backend/output/.gitkeep
backend/tasks.db*
backend/.cleanup-stamp
.plan/
.codegraph/
.claude/
SPEC.md
docs/

# Nuxt build artifacts — generated in whichever directory the build runs from
.nuxt/
.output/

# Nuxt 4 migration leftovers (srcDir default changed to app/)
app/

# Poetry
poetry.lock

# Docker
# .dockerignore is tracked on purpose: without it the build context includes
# backend/tasks.db (the only copy of the usage stats) and every image built
# locally would bake it in — and those images get shipped to ACR.

# Release script — local only. It hardcodes the ACR registry, namespace and
# username plus the ECS deploy steps. The password itself lives in .env, but
# the file is not for publication. Note: dropping it from the index does not
# erase the earlier revisions that remain visible in the GitHub history.
publish.sh

# Environment — contains real API keys, NEVER commit
.env

# OS
.DS_Store
Thumbs.db

# Coverage
htmlcov/
.coverage
.coverage.*

# Tool output
.qoder-credits/
